{
  "name": "sara-note",
  "version": "1.3.0",
  "description": "Sara Note \u2014 a cozy offline notebook, creative studio and desktop companion.",
  "author": "Charitha",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/assets.cjs && node scripts/notices.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke.cjs",
    "test:board": "node scripts/board-smoke.cjs",
    "test:features": "node scripts/features120.cjs",
    "test:colors": "node scripts/color-repro.cjs",
    "test:organization": "node scripts/organization-smoke.cjs"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@uiw/react-codemirror": "^4.25.3",
    "canvas-confetti": "^1.9.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.cutenotes.desktop",
    "productName": "Sara Note",
    "artifactName": "Sara-Note-Setup-${version}.${ext}",
    "directories": {
      "output": "../installers",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/sql.js/dist/{sql-asm*,sql-wasm-browser*,sql-wasm-debug*,sql-wasm-inline*,sqljs-*,sqljs-all.zip,sqljs-wasm.zip,sqljs-worker-wasm.zip,worker.*}"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "cutenote",
        "name": "Sara Note Backup",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "compression": "maximum"
  }
}
